{
  "name": "dsh-squeeze-command",
  "version": "0.1.2",
  "description": "Manual budget-targeted context compression for DeepSeek Harness: the conversation model picks ranges, a cheap flash-tier route writes the checkpoint summaries.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "context",
    "compaction",
    "slash-command"
  ],
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dsh": ">=0.1.1 <0.2.0",
      "dshReleases": {
        "0.1.1": "compatible",
        "0.1.2-rc.1": "compatible"
      }
    }
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-compaction": "*",
    "@deepseek-ai/dsh-llm": "*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-compaction": "0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.6",
    "@deepseek-ai/dsh-scope": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "0.1.0-rc.6",
    "@deepseek-ai/dsh-timeout": "^0.1.0-rc.6"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hardes11/dsh-squeeze-command.git"
  },
  "bugs": {
    "url": "https://github.com/hardes11/dsh-squeeze-command/issues"
  },
  "homepage": "https://github.com/hardes11/dsh-squeeze-command#readme"
}
